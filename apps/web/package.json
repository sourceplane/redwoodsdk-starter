{
  "name": "@app/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "wrangler dev --config wrangler.deploy.jsonc",
    "db:migrate:local": "node ../../tooling/migrations/local.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "wire:fixture": "node ../../tooling/wire/render.mjs --template wrangler.template.jsonc --out wrangler.jsonc --map wiring.fixture.json --env stage && node ../../tooling/wire/render.mjs --template wrangler.deploy.template.jsonc --out wrangler.deploy.jsonc --map wiring.fixture.json --env stage"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "rwsdk": "1.7.5"
  },
  "devDependencies": {
    "@app/eslint-config": "workspace:*",
    "@cloudflare/vite-plugin": "1.50.0",
    "@cloudflare/workers-types": "5.20260801.1",
    "@types/node": "~26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "^9.27.0",
    "typescript": "7.0.2",
    "vite": "~8.2.0",
    "wrangler": "4.118.0"
  }
}
